@model List<CRUDAppUsingASPCoreWebAPIMVC.Models.Student>

@{
    ViewData["Title"] = "Student List";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Student List</h2>

        <a asp-controller="Student" asp-action="Create" class="btn btn-success">
            + Add Student
        </a>
    </div>

    @if (TempData["insert_message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["insert_message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error_Message"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error_Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var student in Model)
                    {
                        <tr>
                            <td>@student.Id</td>
                            <td>@student.Name</td>
                            <td>@student.Gender</td>
                            <td>@student.Age</td>
                            <td>@student.Email</td>

                            <td>
                                <div class="d-flex gap-2">

                                    <a asp-controller="Student" asp-action="Details" asp-route-id="@student.Id"
                                       class="btn btn-info btn-sm text-white">
                                        Details
                                    </a>

                                    <a asp-controller="Student" asp-action="Edit" asp-route-id="@student.Id"
                                       class="btn btn-primary btn-sm">
                                        Edit
                                    </a>

                                    <a asp-controller="Student" asp-action="Delete" asp-route-id="@student.Id"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            No student records found.
        </div>
    }

</div>