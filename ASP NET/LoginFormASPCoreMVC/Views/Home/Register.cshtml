@model LoginFormASPCoreMVC.Models.Student

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
                    <h3 class="mb-0">Student Registration</h3>
                    <small>Create your account</small>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="Home"
                          asp-action="Register"
                          method="post">

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Full Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter your full name"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Gender" class="form-label fw-semibold">
                                Gender
                            </label>

                            <select asp-for="Gender" class="form-select" required>
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Age" class="form-label fw-semibold">
                                Age
                            </label>

                            <input asp-for="Age"
                                   type="number"
                                   class="form-control"
                                   placeholder="Enter your age"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter your email"
                                   required />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold">
                                Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Create a password"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100 py-2 fw-semibold">
                            Register Now
                        </button>

                    </form>

                    @if (ViewBag.Register != null)
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            @ViewBag.Register
                        </div>
                    }

                    <hr />

                    <div class="text-center">
                        <span class="text-muted">Already have an account?</span>
                        <a asp-controller="Home"
                           asp-action="Login"
                           class="text-decoration-none fw-semibold">
                            Login Here
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>