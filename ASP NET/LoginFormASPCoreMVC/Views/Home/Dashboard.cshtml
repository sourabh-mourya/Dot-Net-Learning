@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-primary text-white p-4 rounded-top-4">
            <h3 class="mb-1">Student Dashboard</h3>
            <small>Welcome to your account</small>
        </div>

        <div class="card-body p-4">

            <h4 class="mb-3">
                Welcome, @ViewBag.MySession!
            </h4>

            <p class="text-muted">
                You have successfully logged into your account.
            </p>

            <hr />

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3">
                        <small class="text-muted">Logged-in Email</small>
                        <h6 class="mt-2 mb-0">@ViewBag.MySession</h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3">
                        <small class="text-muted">Session ID</small>
                        <h6 class="mt-2 mb-0 text-break">
                            @ViewBag.MySessionID
                        </h6>
                    </div>
                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center">

                <span class="text-success fw-semibold">
                    <i class="bi bi-check-circle"></i>
                    Login Successful
                </span>

                <form asp-controller="Home"
                      asp-action="Logout"
                      method="get">

                    <button type="submit" class="btn btn-danger">
                        Logout
                    </button>

                </form>

            </div>

        </div>
    </div>
</div>