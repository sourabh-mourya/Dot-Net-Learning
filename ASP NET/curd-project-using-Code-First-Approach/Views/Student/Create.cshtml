@model curd_project_using_Code_First_Approach.Models.Student

@{
    ViewData["Title"] = "Create Student";
}

<div class="container mt-4">

    <h2 class="text-center mb-4">Create Student</h2>

    <div class="row justify-content-center">
        <div class="col-md-6">

            <form asp-controller="Student"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <!-- Student Name -->
                <div class="mb-3">
                    <label asp-for="name" class="form-label"></label>

                    <input asp-for="name"
                           class="form-control"
                           placeholder="Enter student name" />

                    <span asp-validation-for="name"
                          class="text-danger"></span>
                </div>

                <!-- Age -->
                <div class="mb-3">
                    <label asp-for="age" class="form-label"></label>

                    <input asp-for="age"
                           class="form-control"
                           type="number"
                           placeholder="Enter age" />

                    <span asp-validation-for="age"
                          class="text-danger"></span>
                </div>

                <!-- Gender -->
                <div class="mb-3">
                    <label asp-for="gender" class="form-label"></label>

                    <select asp-for="gender" class="form-select">
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>

                    <span asp-validation-for="gender"
                          class="text-danger"></span>
                </div>

                <!-- Standard -->
                <div class="mb-3">
                    <label asp-for="standard" class="form-label"></label>

                    <input asp-for="standard"
                           class="form-control"
                           type="number"
                           placeholder="Enter standard" />

                    <span asp-validation-for="standard"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Student
                    </button>

                    <a asp-controller="Student"
                       asp-action="GetStudents"
                       class="btn btn-secondary">
                        View Students
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
