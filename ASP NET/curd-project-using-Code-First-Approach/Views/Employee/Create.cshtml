
@model curd_project_using_Code_First_Approach.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create Employee</h4>
                </div>

                <div class="card-body">

                    <form asp-controller="Employee"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Employee Name -->
                        <div class="mb-3">
                            <label asp-for="EmpName"
                                   class="form-label"></label>

                            <input asp-for="EmpName"
                                   class="form-control"
                                   placeholder="Enter employee name" />

                            <span asp-validation-for="EmpName"
                                  class="text-danger"></span>
                        </div>

                        <!-- Employee Age -->
                        <div class="mb-3">
                            <label asp-for="EmpAge"
                                   class="form-label"></label>

                            <input asp-for="EmpAge"
                                   type="number"
                                   class="form-control"
                                   placeholder="Enter employee age" />

                            <span asp-validation-for="EmpAge"
                                  class="text-danger"></span>
                        </div>

                        <!-- Employee Salary -->
                        <div class="mb-3">
                            <label asp-for="EmpSalary"
                                   class="form-label"></label>

                            <input asp-for="EmpSalary"
                                   type="number"
                                   class="form-control"
                                   placeholder="Enter employee salary" />

                            <span asp-validation-for="EmpSalary"
                                  class="text-danger"></span>
                        </div>

                        <!-- Employee Designation -->
                        <div class="mb-3">
                            <label asp-for="EmpDesignation"
                                   class="form-label"></label>

                            <input asp-for="EmpDesignation"
                                   class="form-control"
                                   placeholder="Enter employee designation" />

                            <span asp-validation-for="EmpDesignation"
                                  class="text-danger"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Employee
                            </button>

                            <a asp-controller="Employee"
                               asp-action="GetEmployees"
                               class="btn btn-secondary">
                                View Employees
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
