
@model curd_project_using_Code_First_Approach.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container mt-4">

    <h2>Edit Employee</h2>

    <form asp-action="Edit"
          asp-route-id="@Model.EmpId"
          method="post">

        <input type="hidden" asp-for="EmpId" />

        <div class="mb-3">
            <label asp-for="EmpName" class="form-label"></label>
            <input asp-for="EmpName" class="form-control" />
            <span asp-validation-for="EmpName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EmpAge" class="form-label"></label>
            <input asp-for="EmpAge" class="form-control" />
            <span asp-validation-for="EmpAge"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EmpSalary" class="form-label"></label>
            <input asp-for="EmpSalary" class="form-control" />
            <span asp-validation-for="EmpSalary"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EmpDesignation" class="form-label"></label>
            <input asp-for="EmpDesignation" class="form-control" />
            <span asp-validation-for="EmpDesignation"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Update Employee
        </button>

        <a asp-action="GetEmployees" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
